# demo_timer 综合脚本（Yosys，通用门级库），用法：在 IP 目录执行 yowasp-yosys -s syn/synth.ys
read_verilog rtl/demo_timer_core.v rtl/demo_timer_reg.v rtl/demo_timer.v
hierarchy -check -top demo_timer
proc
check -assert
synth -top demo_timer -flatten
abc -g AND,NAND,OR,NOR,XOR,XNOR,MUX
opt_clean
select -assert-none t:$dlatch t:$_DLATCH_*
check -assert
stat
ltp -noff

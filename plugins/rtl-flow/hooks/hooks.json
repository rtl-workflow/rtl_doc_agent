{
  "description": "rtl-flow: role-based path guard, RTL style check after edits, agent handoff validation",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit|Glob|Grep|Bash|PowerShell",
        "hooks": [
          {"type": "command", "command": "python", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/flow_hook.py"], "timeout": 20}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {"type": "command", "command": "python", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/flow_hook.py"], "timeout": 30}
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(rtl-flow:)?(spec-author|architect|rtl-engineer|tb-engineer|debugger)$",
        "hooks": [
          {"type": "command", "command": "python", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/flow_hook.py"], "timeout": 20}
        ]
      }
    ]
  }
}

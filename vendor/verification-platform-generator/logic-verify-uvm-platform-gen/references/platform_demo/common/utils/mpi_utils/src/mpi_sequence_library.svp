`ifndef MPI_SEQUENCE_LIBRARY__SV
`define MPI_SEQUENCE_LIBRARY__SV

/** \brief 
    User decide sequence scenario base on project requirement
    mpi_base_sequence is the base sequence for this interface agent
    mpi_default_sequence is the default sequence to environment runing
*/
class mpi_base_sequence extends uvm_sequence #(mpi_xaction);

    `uvm_object_utils(mpi_base_sequence)
     
    int seq_item_max_num;

    //------------------------------------------------------------------------//
    // Define the member variables base on project requirement                //
    //------------------------------------------------------------------------//
    //-----------------------------Coding begin-------------------------------//

    //-----------------------------Coding end---------------------------------//

    /** \brief Constructor
    Calls super.new(name, parent)
    */
    extern function new(string name = "mpi_base_sequence");

    /** \brief pre_body
    This task is suggest to raise objection
    */
    extern virtual task pre_body();

    /** \brief post_body
    This task is suggest to drop objection
    */
    extern virtual task post_body();

    //------------------------------------------------------------------------//
    // Define the member task/function base on project requirement            //
    //------------------------------------------------------------------------//
    //-----------------------------Coding begin-------------------------------//

    //-----------------------------Coding end---------------------------------//

endclass

function mpi_base_sequence::new(string name = "mpi_base_sequence");

	super.new(name);
    this.seq_item_max_num = 0;

endfunction 

task mpi_base_sequence::pre_body();
        
    if(starting_phase != null) begin
    	starting_phase.raise_objection(this);
    end

endtask: pre_body

task mpi_base_sequence::post_body();
         
    if(starting_phase != null) begin
        starting_phase.drop_objection(this);
    end

endtask: post_body

class mpi_default_sequence extends mpi_base_sequence;

    `uvm_object_utils(mpi_default_sequence)

    //------------------------------------------------------------------------//
    // Define the member variables base on project requirement                //
    //------------------------------------------------------------------------//
    //-----------------------------Coding begin-------------------------------//

    //-----------------------------Coding end---------------------------------//

    /** \brief Constructor
    Calls super.new(name, parent)
    */
    extern function new(string name = "mpi_default_sequence");

    /** \brief body
    This task is send item to sequencer
    */
    extern virtual task body();

    //------------------------------------------------------------------------//
    // Define the member task/function base on project requirement            //
    //------------------------------------------------------------------------//
    //-----------------------------Coding begin-------------------------------//

    //-----------------------------Coding end---------------------------------//

endclass

function mpi_default_sequence::new(string name = "mpi_default_sequence");

	super.new(name);

endfunction 

task mpi_default_sequence::body();
        
    //------------------------------------------------------------------------//
    //  Extend body() base on project requirement                            //
    //------------------------------------------------------------------------//    
    //-----------------------------Coding begin-------------------------------//
    void '(uvm_config_db #(int)::get(null, get_full_name(), "seq_item_max_num", this.seq_item_max_num));
    `uvm_info(get_type_name(), $sformatf("body(): the send number value is %0d", this.seq_item_max_num), UVM_HIGH);
    repeat(this.seq_item_max_num) begin
        `uvm_do(req)
	end
    //-----------------------------Coding end---------------------------------//

endtask: body

`endif


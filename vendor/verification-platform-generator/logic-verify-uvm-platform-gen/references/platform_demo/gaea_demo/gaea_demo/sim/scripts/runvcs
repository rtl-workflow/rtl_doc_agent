    #set vcs_cmp_options = "$vcs_cmp_options +incdir+$VCS_HOME/etc/$uvm_vmm/src $VCS_HOME/etc/${uvm_vmm}/src/uvm.sv"
    #set vcs_cmp_options = "$vcs_cmp_options $VCS_HOME/etc/$uvm_vmm/src/dpi/uvm_dpi.cc -CFLAGS -DVCS"

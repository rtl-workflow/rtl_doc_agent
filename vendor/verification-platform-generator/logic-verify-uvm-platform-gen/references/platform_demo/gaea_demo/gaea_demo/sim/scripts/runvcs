        rm -rf ../sim_resultlog.filelock
        exit
    endif

    if (-e "esadb.esdb++") rm -rf "esadb.esdb++"
    if ($company == "altera") then
        esa -db esadb -top $th_top -bas $th_top -exclude altsyncram
    else if ($company == "xilinx") then
        esa -db esadb -top $th_top -bas $th_top -exclude XILINX_DCBDP_RAM_v XILINX_DCSDP_RAM_v XILINX_SDP_RAM_v
    else
        esa -db esadb -top $th_top -bas $th_top
    endif
    if (! -e "esadb.esdb++") then
        lockfile -1 -l 5  ../sim_resultlog.filelock
        echo "TESTCASE `basename $dir_name` esa compile ERROR $HOSTNAME @ `date +'%x %T'` " | tee  -a ../sim_result.log
        rm -rf ../sim_resultlog.filelock
        exit
    endif
else
    set esa_option  = ""
endif


echo "*****************************************************"
set test_dir = `find  $tests_dir -name $case_id.sv -follow`
set test_tcl = `find  $tests_dir -name $case_id.tcl -follow`
set case_id_ori = $case_id
ln -s $test_dir  ./
ln -s $test_tcl  ./
ln -s `find $src_path -name "*.mif"` ./

#*****************************************************"
# extract testcase define
#*****************************************************"
set def = `grep -o '^[^//]*' ${case_id}.sv |grep define|grep -i -v $case_id |awk '{gsub(".define","define");print}'`
set def_tc = ""
set macro_name = ""
set macro_value = ""
foreach def_var ($def)
    if ("$def_var" == "define") then
        if (("$macro_value" != "")&&("$macro_name" != "")) then
            set def_tc = "$def_tc +define+$macro_name=$macro_value"
        else if ("$macro_name" != "") then
            set def_tc = "$def_tc +define+$macro_name"
        endif
        set macro_name = ""
        set macro_value = ""
    else if ("$macro_name" == "") then
        set macro_name = $def_var
    else if ("$macro_value" == "") then
        set macro_value = $def_var
    endif
end
if (("$macro_value" != "")&&("$macro_name" != "")) then
    set def_tc = "$def_tc +define+$macro_name=$macro_value"
else if ("$macro_name" != "") then
    set def_tc = "$def_tc +define+$macro_name"
endif

if ("$def_tc" != "") then
    echo "def_tc=$def_tc"
    set vcs_cmp_options = "$vcs_cmp_options $def_tc"
endif
#*****************************************************"
# extract testcase define end
#*****************************************************"


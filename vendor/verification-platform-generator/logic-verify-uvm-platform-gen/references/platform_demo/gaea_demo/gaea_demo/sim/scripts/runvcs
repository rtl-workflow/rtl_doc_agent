if ($vhdl_en == "on") then
    #  gen synopsys_sim.setup file
    rm -rf synopsys_sim.setup
    touch synopsys_sim.setup
    while ($#synopsys_sim_setup)
        echo $synopsys_sim_setup[1] >> synopsys_sim.setup
        shift  synopsys_sim_setup
    end

    # compile vhdl lib 
    while ($#vhdl_liblist)
        set vhdl_lib_flist = $vhdl_liblist[1]
        shift  vhdl_liblist
        set vhdl_lib_name  = $vhdl_liblist[1]
        shift  vhdl_liblist

        echo "Compile VHDL lib $vhdl_lib_name..."

        mkdir $vhdl_lib_name

        vhdlan  \
            #-nc                  \
            -kdb                 \
            -full64               \
            $vhdl_lib_flist       \
            -work $vhdl_lib_name  \
            -l       vhdlan.log                     

        if ($status != 0) then
            echo "*****************************************************"
            echo "<<<<<<<<<<<<    VCS VHDL COMPILE $vhdl_lib_name ERROR     >>>>>>>>>>>>>>>"
            echo "*****************************************************"
            lockfile -1 -l 5  ../sim_resultlog.filelock
            echo "TESTCASE `basename $dir_name` vcs vhdl compile ERROR $HOSTNAME @ `date +'%x %T'` $case_id/cmp.log" | tee  -a ../sim_result.log
            rm -rf ../sim_resultlog.filelock
            if ($open_gvim == "on") gvim vhdlan.log
            exit
        endif
    end

    # compile vhdl user file
    mkdir work
    vhdlan  \
        #-nc                                            \
        -kdb                                            \
        -full64                                         \
        $vhdl_filelist                                  \
        -l       vhdlan.log                     

    if ($status != 0) then
        echo "*****************************************************"
        echo "<<<<<<<<<<<<    VCS VHDL COMPILE ERROR     >>>>>>>>>>>>>>>"
        echo "*****************************************************"
        lockfile -1 -l 5  ../sim_resultlog.filelock
        echo "TESTCASE `basename $dir_name` vcs vhdl compile ERROR $HOSTNAME @ `date +'%x %T'` $case_id/cmp.log" | tee  -a ../sim_result.log
        rm -rf ../sim_resultlog.filelock
        if ($open_gvim == "on") gvim vhdlan.log
        exit
    endif

	vlogan -full64 -kdb -sverilog -ntb_opts $uvm_vmm

    vlogan                                              \
        #-nc                                            \
        -kdb                                            \
        -lca                                            \
        -full64                                         \
        +vcs+lic+wait                                   \
        -sverilog                                       \
        +v2k                                            \
        +verilog2001ext+.vp                             \
        #+define+BALANCED -parallel+autopart=3+all       \
        -timescale=1ns/100ps                              \
        -unit_timescale=1ns/100ps                         \
        -ntb_opts tb_timescale=1ns/100ps                  \
        +vcs+flush+all                                  \
        +vcs+loopreport                                 \
        +vcs+loopdetect                                 \
        #+vcs+initreg+0|1|x|z                            \
        #+vcs+initreg+random                             \
        -ntb_opts $uvm_vmm                              \
        $vcs_cmp_options                                \
        +libext+.sv                                     \
        +libext+.v                                      \
        #-debug_access+all                               \
        +incdir+${VCS_HOME}/packages/sva                \
        $filelist                                       \
        -l       vlogan.log                     \
        $test_dir

    if ($status != 0) then
        echo "*****************************************************"
        echo "<<<<<<<<<<<<    VCS VERILOG COMPILE ERROR     >>>>>>>>>>>>>>>"
        echo "*****************************************************"
        lockfile -1 -l 5  ../sim_resultlog.filelock
        echo "TESTCASE `basename $dir_name` vcs verilog compile ERROR $HOSTNAME @ `date +'%x %T'` $case_id/cmp.log" | tee  -a ../sim_result.log
        rm -rf ../sim_resultlog.filelock

        #echo -n "Do you want to open log file ?(Y/n)"
        #set ack = $<
        #if ($ack == Y || $ack == y) then
        if ($open_gvim == "on") gvim vlogan.log
        #endif
        exit
    endif

    vcs                                                 \
        #-nc                                             \
        -kdb                                            \
        -lca                                            \
        -full64                                         \
        +vcs+lic+wait                                   \
        -Mupdate                                        \
        -fsdb \
        +vpi                                            \
        +rad                                            \
        -ntb_opts $uvm_vmm                              \
        -debug_access+all \
        #$debug_option \
        -top     $th_top                                \
        -l       cmp.log                     \
        -o       simv                                   

    if ($status != 0) then
        echo "*****************************************************"
        echo "<<<<<<<<<<<<    VCS COMPILE ERROR     >>>>>>>>>>>>>>>"
        echo "*****************************************************"
        lockfile -1 -l 5  ../sim_resultlog.filelock
        echo "TESTCASE `basename $dir_name` vcs compile ERROR $HOSTNAME @ `date +'%x %T'` $case_id/cmp.log" | tee  -a ../sim_result.log
        rm -rf ../sim_resultlog.filelock
        if ($open_gvim == "on") gvim cmp.log
        exit
    endif

else

vcs                                                 \
    #-nc                                             \
    -kdb                                            \
    -lca                                            \
    -full64                                         \
    +vcs+lic+wait                                   \
    -sverilog                                       \
    -Mupdate                                        \
    +vpi                                            \
    +v2k                                            \
    +verilog2001ext+.vp                             \
    +rad                                            \
    #+define+BALANCED -parallel+autopart=3+all       \
    -timescale=1ns/100ps                              \
    -unit_timescale=1ns/100ps                         \
    -ntb_opts tb_timescale=1ns/100ps                  \
    +vcs+flush+all                                  \
    +vcs+loopreport                                 \
    +vcs+loopdetect                                 \
    #+vcs+initreg+0|1|x|z                            \
    #+vcs+initreg+random                             \
    -ntb_opts $uvm_vmm                              \
    $vcs_cmp_options                                \
    +libext+.sv                                     \
    +libext+.v                                      \
    #-debug_access+all                               \
    +incdir+${VCS_HOME}/packages/sva                \
    $filelist                                       \
    -top     $th_top                                \
    -l       cmp.log                     \
    -o       simv                                   \
    $test_dir

if ($status != 0) then
    echo "*****************************************************"
    echo "<<<<<<<<<<<<    VCS COMPILE ERROR     >>>>>>>>>>>>>>>"
    echo "*****************************************************"
    lockfile -1 -l 5  ../sim_resultlog.filelock
    echo "TESTCASE `basename $dir_name` vcs compile ERROR $HOSTNAME @ `date +'%x %T'` $case_id/cmp.log" | tee  -a ../sim_result.log
    rm -rf ../sim_resultlog.filelock

    #echo -n "Do you want to open log file ?(Y/n)"
    #set ack = $<
    #if ($ack == Y || $ack == y) then
    if ($open_gvim == "on") gvim cmp.log
    #endif
    exit
endif

endif

echo "*****************************************************"
echo " SIMULATION START ..."
echo "*****************************************************"

set run_start_time = `date +"%x %T"`
set run_start_time_s = `date +"%s"`

simv                                    \
    +vcs+lic+wait                       \
    $vcs_sim_options                    \
    #+vcs+initreg+0                     \
    #+vcs+initreg+random                \
    $esa_option                         \
    -ucli -do $script_path/run.tcl      \
    -l        sim.log


if ($status != 0) then
    lockfile -1 -l 5  ../sim_resultlog.filelock
    echo "TESTCASE `basename $dir_name` simulate ERROR $HOSTNAME @ `date +'%x %T'`"  | tee  -a ../sim_result.log
    rm -rf ../sim_resultlog.filelock
    exit
endif

set run_end_time   = `date +"%x %T"`
set run_end_time_s = `date +"%s"`

echo "*****************************************************"
echo " CHECK SIMULATION RESULT..."
echo "*****************************************************"
set autocheck = "PASS"
if (! -e testcase_ok) set autocheck = "ERROR"

echo " SIM ERROR KEYWORD CHECK RESULT" | tee -a sim.log
echo "--------------------------------------------------------------" | tee -a sim.log
printf "%-20s %-20s %s\n" "KEYWORD"  "CNT" "RESULT"  | tee -a sim.log
echo "--------------------------------------------------------------" | tee -a sim.log
while (${#sim_err_keyword} > 0)
    set keyword = "${sim_err_keyword[1]}"
    shift sim_err_keyword
    set cnt = `grep -ic "$keyword"  sim.log`
    if ($cnt > 0) then
        set autocheck = "ERROR"
        printf "%-20s %-20d ERROR\n" "$keyword"  $cnt  | tee -a sim.log
    else
        printf "%-20s %-20d OK\n" "$keyword"  $cnt  | tee -a sim.log
    endif
end
echo "--------------------------------------------------------------" | tee -a sim.log

set seed = ""
if ($rand_seed == "" || $rand_seed == "random") then
    set seed = `grep "random seed" sim.log | sed "s/^.*used:\s*//g"`
    set seed2 = "random seed: $seed/`printf 0x%x $seed`"
else
    #set seed = `grep "Initial random seed" sim.log | sed "s/^..*is\s*//g"`
    set seed = `grep "ntb_random_seed" sim.log | sed 's/^.*ntb_random_seed=\([0-9]\+\)\s\+.*$/\1/g'`
    set seed2 = "fix seed: $seed/`printf 0x%x $seed`"
endif

# speed
set run_time     = `grep "^Time:.*" sim.log | tail -n 1| sed "s/^Time:\s*//g" `
set run_time_unit =  `echo $run_time | sed "s/[0-9]*\s*//g"`
set run_time     = `echo $run_time| sed "s/\s*[fp]s//g"`
set run_time_ms = "0"
if ($run_time_unit == "fs") then
    set run_time_ms = `echo "scale=3; $run_time/1000000000000" | bc`
else if ($run_time_unit == "ps") then
    set run_time_ms  = `echo "scale=3; $run_time/1000000000" | bc`
endif
set cpu_time_min = `echo "scale=3; (${run_end_time_s} - ${run_start_time_s})/60" | bc` # change unit to ms

set speed = "0"
if ($run_time_ms != 0) then
    set speed        = `echo "scale=3; ${cpu_time_min}/${run_time_ms}"|bc`
endif
set speed_str    = "${speed}min/ms (${cpu_time_min}min/${run_time_ms}ms)"

# info stat
grep -A 10 "Report counts by severity" sim.log > stat
set f_cnt = `cat stat | grep UVM_FATAL | sed "s/UVM_FATAL\s*:\s*//"`
set e_cnt = `cat stat | grep UVM_ERROR | sed "s/UVM_ERROR\s*:\s*//"`
set w_cnt = `cat stat | grep UVM_WARNING | sed "s/UVM_WARNING\s*:\s*//"`
set i_cnt = `cat stat | grep UVM_INFO | sed "s/UVM_INFO\s*:\s*//"`
set stat_msg = "F($f_cnt)/E($e_cnt)/W($w_cnt)/I($i_cnt)"

lockfile -1 -l 5  ../sim_resultlog.filelock
printf "TESTCASE %-35s simulation $autocheck $stat_msg @${HOSTNAME} ($run_start_time ~ $run_end_time) speed $speed_str $seed2 $dir_name/sim.log $dir_name/$case_id.sv\n" `basename $dir_name` | tee -a sim.log ../sim_result.log
rm -rf ../sim_resultlog.filelock

if ($auto_regress == "on" && $autocheck == "ERROR") then
    set sub_option = `echo $sub_option | sed "s/-auto_regress//g"`
    set sub_option = `echo $sub_option | sed "s/-nowave//g"`
    
    #get first UVM_ERROR or UVM_FATAL time
    if ($fsdbontime != "") then
        #get the first error or fatal time
        if ($e_cnt > 0 ) then
            set first_errtime = `grep -m 1 "UVM_ERROR" sim.log | awk '{print $4}'`
        else if ($f_cnt > 0) then
            set first_errtime = `grep -m 1 "UVM_FATAL" sim.log | awk '{print $4}'`
        endif
        #get time number and time unit
        if ($first_errtime != "") then
            set errtime_num1  = `echo $first_errtime | grep -o "[0-9]\+"`
            set errtime_unit1 = `echo $first_errtime | grep -o "[m,u,n,p,f]\?s"`
            if ( ($errtime_num1 == "") || ($errtime_unit1 == "")) then
                set errtime_num1  = 0 ;
                set errtime_unit1 = ns ;
            endif
        endif
        if ($fsdberrtime != "") then
            set errtime_num2  = `echo $fsdberrtime | grep -o "[0-9]\+"`
            set errtime_unit2 = `echo $fsdberrtime | grep -o "[m,u,n,p,f]\?s"`
            if ( ($errtime_num2 == "") || ($errtime_unit2 == "")) then
                set errtime_num1  = 0 ;
                set errtime_unit1 = ns ;
            endif
        endif

        #transfer time to ns
        foreach cnt (1 2)
            switch (`eval echo \$errtime_unit${cnt}`)
                #echo " errtime_unit${cnt} = \$errtime_unit${cnt}"
                case "s":
                    @ errtime_num${cnt} *= 1000000000 ;
                    breaksw;
                case "ms":
                    @ errtime_num${cnt} *= 1000000    ;
                    breaksw;
                case "us":
                    @ errtime_num${cnt} *= 1000       ;
                    breaksw;
                case "ns":
                    @ errtime_num${cnt} *= 1          ;
                    breaksw;
                case "ps":
                    @ errtime_num${cnt} /= 1000       ;
                    breaksw;
                case "fs":
                    @ errtime_num${cnt} /= 1000000    ;
                    breaksw;
                default :
                    @ errtime_num${cnt} = 0           ;
                    echo "simtime unit \$errtime_unit${cnt} is error"
                    breaksw
            endsw
        end
        #judge the start time
        if ($errtime_num1 < $errtime_num2) then
            echo "NOTE:first error occur time ($errtime_num1 ns) < fsdb before time($errtime_num2 ns)"
            setenv fsdbontime 0ns
        else
            @ fsdbontime_num = $errtime_num1 - $errtime_num2
            setenv fsdbontime ${fsdbontime_num}ns
            echo "fsdbontime:$fsdbontime"
        endif
        set sub_option = "$sub_option -fsdbontime $fsdbontime "
    endif
    cd ../scripts
    echo "Are you sure to regress testcases $case_id? (Press Ctrl+c to break!)"
    echo "3" ; sleep 1
    echo "2" ; sleep 1
    echo "1" ; sleep 1
    runvcs -error_regress -tc $case_id_ori -seed $seed -fsdb $sub_option
endif
